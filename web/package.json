{
  "name": "lineal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "graphql-codegen --config codegen.ts && tsr generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "routes": "tsr generate",
    "typecheck": "graphql-codegen --config codegen.ts && tsr generate && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
