DATABASE_URL=postgres://lineal:lineal@localhost:5440/lineal
LINEAL_BASE_URL=http://localhost:8080
LINEAL_SESSION_SECRET=change-me-32-bytes-minimum-xxxxxxxx
LINEAL_BLOB_DIR=./var/blobs
RUST_LOG=info,lineal=debug
LINEAL_DEV=true
# Erlaubte Origins für Cookie-Sessions (CSRF), Komma-Liste; leer = Origin von LINEAL_BASE_URL
#LINEAL_ALLOWED_ORIGINS=
# Vertrauenswürdige Reverse-Proxys (CIDR, Komma-Liste) für X-Forwarded-For; leer = ignorieren
#LINEAL_TRUSTED_PROXIES=
# Wer per GraphQL `createWorkspace` weitere Workspaces anlegen darf: disabled | admins | all.
# Default: all mit LINEAL_DEV, sonst disabled. `lineal create-workspace` (CLI) ist ausgenommen.
#LINEAL_WORKSPACE_CREATION=disabled
# Nur für `admins`: Komma-Liste von User-UUIDs (aktive Owner/Admins; `lineal create-workspace`
# gibt die ID aus). Keine E-Mails: Die lassen sich in fremden Workspaces anlegen.
#LINEAL_INSTANCE_ADMINS=0190f1c2-7b1e-7c3a-9d2e-5a4b6c7d8e9f

# --- Docker-Stack (docker compose --profile app up -d --build) -------------------------------
# Pflicht: openssl rand -hex 32
#LINEAL_SESSION_SECRET=
# Pflicht, nur URL-sichere Zeichen: openssl rand -hex 24 (Passwort der DB `app-db`)
#LINEAL_DB_PASSWORD=
#LINEAL_BASE_URL=http://localhost:8088
#LINEAL_HTTP_PORT=8088
# Ersteinrichtung danach:
#   LINEAL_OWNER_PASSWORD=... docker compose --profile app run --rm -e LINEAL_OWNER_PASSWORD migrate \
#     create-workspace --name "Acme" --owner-email alice@acme.example --owner-name "Alice"
